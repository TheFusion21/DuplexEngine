# Prerequisites
*.d

# Compiled Object files
# NOTE: *.obj deliberately excluded here - it collides with Wavefront .obj mesh assets
# (e.g. data/mdls/**/*.obj) and silently blocked one from ever being committed. All real
# compiled .obj output already lands under /build (ignored below), so this isn't needed
# for its original purpose either.
*.slo
*.lo
*.o

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

/.vs
/out
/build
/.vscode
/_ReSharper.Caches
/CMakeSettings.json
/lib

bin/

# Runtime config written by engine.editor next to wherever it's run from
/EngineConfig.ini

# Dear ImGui's own window-layout state, written next to wherever it's run from
/imgui.ini
